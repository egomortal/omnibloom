#version 450
// SPDX-License-Identifier: GPL-3.0-or-later
// OMNI_GPU_PRESENT_V2, HDR phase 2: the composed SDR frame (sRGB-encoded RGBA8: page + SDR video) -> BT.2020 PQ
// (SMPTE ST 2084) at `white` nits for SDR white (BT.2408: 203). Output packed as OmniHdrColour.h's pack():
// R | G << 10 | B << 20 | 3 << 30 (VK_FORMAT_A2B10G10R10_UNORM_PACK32), one uint per pixel, rows of `w`.
// Constants: Omni's OmniHdrColour.h overlay() and Ex-Box's modules/gpu_presenter/video.comp (both GPL-3.0-or-later).
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(rgba8, set = 0, binding = 0) readonly uniform image2D canvas;
layout(std430, set = 0, binding = 1) writeonly buffer Out { uint px[]; };
layout(push_constant) uniform P { int w, h; float white; int pad; } p;

vec3 srgbLinear(vec3 v) { return mix(pow((v + 0.055) / 1.055, vec3(2.4)), v / 12.92, lessThanEqual(v, vec3(0.04045))); }
vec3 pqEncode(vec3 nits)
{
    vec3 v = pow(clamp(nits / 10000.0, 0.0, 1.0), vec3(2610.0 / 16384.0));
    return pow((3424.0 / 4096.0 + 2413.0 / 128.0 * v) / (1.0 + 2392.0 / 128.0 * v), vec3(2523.0 / 32.0));
}
void main()
{
    ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    if (xy.x >= p.w || xy.y >= p.h) return;
    vec3 s = srgbLinear(clamp(imageLoad(canvas, xy).rgb, 0.0, 1.0));
    vec3 wide = vec3(dot(s, vec3(0.6274038959, 0.3292830384, 0.0433130657)),
                     dot(s, vec3(0.0690972894, 0.9195403951, 0.0113623156)),
                     dot(s, vec3(0.0163914389, 0.0880133079, 0.8955952532)));
    uvec3 q = uvec3(clamp(pqEncode(wide * p.white), 0.0, 1.0) * 1023.0 + 0.5);
    px[uint(xy.y * p.w + xy.x)] = q.r | (q.g << 10) | (q.b << 20) | 0xc0000000u;
}
