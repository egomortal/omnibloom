#version 450
// SPDX-License-Identifier: GPL-3.0-or-later
// OMNI_COLOUR_FILTER_V1 (tools/apply_colour_filter_present.py): the one colour pass over the composed canvas, in place.
// Night light's pass (omni_night_light.comp) generalised to an affine map: out.rgb = M * canvas.rgb + o on the stored
// (gamma-encoded) values, clamped; alpha kept. M is row-major 3x3, one row per vec4; the row's w is that channel's
// offset o (0 for every matrix except Invert's 1). The present composes Night light (N) x Colour filter (F, f):
// M = N F, o = N f, so both features cost ONE dispatch, and none while both are off.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(rgba8, set = 0, binding = 0) uniform image2D canvas;
layout(push_constant) uniform P { vec4 r0, r1, r2; ivec4 size; } p;
void main()
{
    ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    if (xy.x >= p.size.x || xy.y >= p.size.y) return;
    vec4 c = imageLoad(canvas, xy);
    vec3 o = vec3(dot(p.r0.xyz, c.rgb) + p.r0.w, dot(p.r1.xyz, c.rgb) + p.r1.w, dot(p.r2.xyz, c.rgb) + p.r2.w);
    imageStore(canvas, xy, vec4(clamp(o, 0.0, 1.0), c.a));
}
