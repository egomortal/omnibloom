diff -ruN a/engine/entry/OmniPointerCross.h b/engine/entry/OmniPointerCross.h
--- a/engine/entry/OmniPointerCross.h
+++ b/engine/entry/OmniPointerCross.h
@@ -0,0 +1,52 @@
+// OMNI_POINTER_CROSS_V1: Cross acts where the pointer is while the pointer is the active input.
+// Before: Cross went to button(A), whose handlers (built-in pages, the Master Control page, overlays, the Options/fx
+// panels) all acted on their own D-pad highlight, so with the stick-driven pointer over "Apps" in Options, Cross ran the
+// highlighted (disabled) "Back" tile, and on the Master Control page the page's own Cross handler took it before any
+// click could reach the element under the pointer. Only a real SDL mouse button reached click(), the pointer hit-test.
+// Now: the pointer leads after the stick or a mouse moves it and the D-pad hands the lead back to the highlight
+// (also a list scrolled by the right stick, which moves the highlight). While the pointer leads and is visible, Cross
+// runs click() at the pointer, exactly as a mouse click, except that Cross on no item of an open panel does nothing
+// (a mouse click there closes the panel; Circle still does). Moving the pointer over a row highlights it.
+// Pure state and decisions only: unit-tested on the host (hosttest/pointer_cross_test.cpp).
+#pragma once
+
+struct OmniPtrCrossState {
+    bool active = false;    // the pointer leads (stick or mouse moved it since the last D-pad press)
+    bool inCross = false;   // a Cross press is running as a pointer click right now
+    unsigned crossClicks = 0, dpadHandBacks = 0;
+};
+static OmniPtrCrossState omniPtrCross;
+
+static inline bool omniPtrCrossIsDpad(int b)
+{
+    return b == SDL_CONTROLLER_BUTTON_DPAD_UP || b == SDL_CONTROLLER_BUTTON_DPAD_DOWN
+        || b == SDL_CONTROLLER_BUTTON_DPAD_LEFT || b == SDL_CONTROLLER_BUTTON_DPAD_RIGHT;
+}
+// The stick or a mouse moved the pointer.
+static inline void omniPtrCrossMoved() { omniPtrCross.active = true; }
+// The highlight moved by list navigation (D-pad, right stick in a list): Cross follows the highlight again.
+static inline void omniPtrCrossListNav() { if (omniPtrCross.active) ++omniPtrCross.dpadHandBacks; omniPtrCross.active = false; }
+// First thing in button(): the D-pad hands the lead back; true when this button is a Cross to run as a pointer click.
+static inline bool omniPtrCrossRoute(int b, bool pointerVisible)
+{
+    if (omniPtrCrossIsDpad(b)) { omniPtrCrossListNav(); return false; }
+    return b == SDL_CONTROLLER_BUTTON_A && omniPtrCross.active && pointerVisible;
+}
+// Marks the click() that a Cross runs (panels then ignore a press off their items instead of closing).
+struct OmniPtrCrossScope {
+    OmniPtrCrossScope() { omniPtrCross.inCross = true; ++omniPtrCross.crossClicks; }
+    ~OmniPtrCrossScope() { omniPtrCross.inCross = false; }
+    OmniPtrCrossScope(const OmniPtrCrossScope&) = delete;
+    OmniPtrCrossScope& operator=(const OmniPtrCrossScope&) = delete;
+};
+// Browser settings panel (settingsOpen): the row a point is on, -1 none (the same bands as omniSettingsClick).
+static inline int omniPtrSettingsRowAt(int x, int y)
+{
+    if (x < 332 || x >= 948) return -1;
+    if (y >= 232 && y < 316) return 0;
+    if (y >= 360 && y < 412) return 1;
+    if (y >= 426 && y < 496) return 2;
+    if (y >= 534 && y < 574) return 3;
+    if (y >= 588 && y < 632) return 4;
+    return -1;
+}
