diff --git a/setup/omnibloom_setup/port_registry.py b/setup/omnibloom_setup/port_registry.py
new file mode 100644
index 0000000..c40b2ed
--- /dev/null
+++ b/setup/omnibloom_setup/port_registry.py
@@ -0,0 +1,53 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Port claims from Bloom Core's current status, without contacting any app."""
+import re
+import time
+
+ID = re.compile(r"[a-z0-9][a-z0-9-]{0,39}\Z")
+
+
+def suite_port(value):
+    """Assigned suite ports; 8760 remains Bloom Core's fixed endpoint."""
+    return type(value) is int and 8761 <= value <= 8899
+
+
+def live_claims(snapshot, now=None):
+    """Only a fresh, verified, running status row reserves a live port.
+
+    Card claims remain independently reserved by PortPicker. A stale status
+    cannot establish that a PID still belongs to the same running service.
+    """
+    now = time.time() if now is None else now
+    if not isinstance(snapshot, dict):
+        return {}
+    stamp = snapshot.get("written_at")
+    if type(stamp) not in (int, float) or not 0 <= now - stamp <= 30:
+        return {}
+    rows = snapshot.get("apps")
+    if not isinstance(rows, list):
+        return {}
+    claims = {}
+    for row in rows[:128]:
+        if not isinstance(row, dict):
+            continue
+        ident, port = row.get("id"), row.get("port")
+        if (isinstance(ident, str) and ID.fullmatch(ident) and suite_port(port)
+                and row.get("verified") is True and row.get("up") is True):
+            claims.setdefault(port, set()).add(ident)
+        runtime = row.get("runtime")
+        if (isinstance(ident, str) and ID.fullmatch(ident) and isinstance(runtime, dict)
+                and row.get("verified") is True and row.get("up") is True
+                and not row.get("runtime_note") and type(runtime.get("pid")) is int
+                and runtime["pid"] > 0 and suite_port(runtime.get("port"))):
+            claims.setdefault(runtime["port"], set()).add(ident)
+    return claims
+
+
+def read_live_claims(console, now=None):
+    # Reader is the existing bounded Setup metadata reader, not an app probe.
+    from .doctor import Reader
+    try:
+        snapshot = Reader(console).json("/data/hub/status.json", 1024 * 1024)
+    except (OSError, ValueError, UnicodeError, TypeError):
+        return {}
+    return live_claims(snapshot, now)
