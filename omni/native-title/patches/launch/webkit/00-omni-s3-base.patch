+
+static const char* findReplayHazard(const SkPicture& picture)
+{
+    HazardScan scan(picture.cullRect().roundOut());
+    picture.playback(&scan);
+    return scan.hazard();
+}
+
+struct ReplayJob {
+    const SkPicture* picture { nullptr };
+    SkCanvas* canvases[maxThreads] { };
+    int width { 0 };
+    BandPlan plan;
+};
+
+static void replayBand(void* context, unsigned worker, unsigned band)
+{
+    auto& job = *static_cast<ReplayJob*>(context);
+    SkCanvas* canvas = job.canvases[worker];
+    int top = 0, bottom = 0;
+    job.plan.band(band, top, bottom);
+    if (top >= bottom)
+        return;
+    canvas->save();
+    canvas->clipIRect(SkIRect::MakeLTRB(0, top, job.width, bottom));
+    job.picture->playback(canvas);
+    canvas->restore();
+}
+
+// surfaces[0..surfaceCount) all wrap the same pixels; surfaceCount is the thread count.
+// Returns the hazard when the picture was replayed on the calling thread only.
+static const char* replay(const SkPicture& picture, SkSurface* const* surfaces, unsigned surfaceCount, int width, const BandPlan& plan, unsigned& bandsUsed)
+{
+    if (const char* hazard = findReplayHazard(picture)) {
+        picture.playback(surfaces[0]->getCanvas());
+        bandsUsed = 1;
+        return hazard;
+    }
+    surfaceCount = std::clamp(surfaceCount, 1u, maxThreads);
+    ReplayJob job;
+    job.picture = &picture;
+    for (unsigned i = 0; i < surfaceCount; ++i)
+        job.canvases[i] = surfaces[i]->getCanvas();
+    job.width = width;
+    job.plan = plan;
+    pool(surfaceCount).run(plan.bandCount, replayBand, &job);
+    bandsUsed = plan.bandCount;
+    return nullptr;
+}
+
+// Debug check (OMNI_RASTER_VERIFY=1): the same bands replayed sequentially on the calling thread
+// into scratch memory, compared with the parallel result. Must be 0; anything else means a race
+// or thread-unsafe content. Returns the number of differing pixels.
+static uint64_t countMismatches(const SkPicture& picture, const SkImageInfo& info, const SkSurfaceProps& props, const BandPlan& plan, const uint8_t* pixels, size_t rowBytes)
+{
+    auto reference = SkSurfaces::Raster(info, &props);
+    if (!reference)
+        return 0;
+    ReplayJob job;
+    job.picture = &picture;
+    job.canvases[0] = reference->getCanvas();
+    job.width = info.width();
+    job.plan = plan;
+    for (unsigned band = 0; band < plan.bandCount; ++band)
+        replayBand(&job, 0, band);
+    SkPixmap expected;
+    if (!reference->peekPixels(&expected))
+        return 0;
+    uint64_t mismatches = 0;
+    size_t rowLength = static_cast<size_t>(info.width()) * 4;
+    for (int y = 0; y < info.height(); ++y) {
+        const uint8_t* actualRow = pixels + rowBytes * y;
+        const uint8_t* expectedRow = static_cast<const uint8_t*>(expected.addr(0, y));
+        if (!std::memcmp(actualRow, expectedRow, rowLength))
+            continue;
+        for (size_t offset = 0; offset < rowLength; offset += 4)
+            mismatches += !!std::memcmp(actualRow + offset, expectedRow + offset, 4);
+    }
+    return mismatches;
+}
