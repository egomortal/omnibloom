+    char target[8192];
+    if (!omniUBlockRewrite(reinterpret_cast<const char*>(request.url().string().utf8().data()), "", "main_frame", blocked, target, sizeof(target))) return { };
+    URL rewritten { String::fromUTF8(target) };
+    if (!rewritten.isValid() || !rewritten.protocolIsInHTTPFamily() || rewritten.string() == request.url().string()) return { };
+    return rewritten.string();
+}
+static bool omniFilterRequest(const WebCore::ResourceRequest& request, const URL& documentURL, WebCore::FetchOptions::Destination destination, bool mainFrame)
+{
+    if (!request.url().protocolIsInHTTPFamily()) return false;
+    // omni independent update protection: checked before uBlock's enabled state.
+    auto updateHost = request.url().host().toString().convertToASCIILowercase();
+    while (updateHost.endsWith('.')) updateHost = updateHost.left(updateHost.length() - 1);
+    if (updateHost == "update.playstation.net"_s || updateHost.endsWith(".update.playstation.net"_s)
+        || updateHost == "dl.playstation.net"_s || updateHost.endsWith(".dl.playstation.net"_s)) return true;
+    // omni OMNI_SEC_PNA_V1: a public page may not reach the home network (checked before trusted-site/uBlock-off)
+    if (omniPrivateNetworkBlocked(reinterpret_cast<const char*>(request.url().string().utf8().data()), reinterpret_cast<const char*>(documentURL.string().utf8().data()))) return true;
