+    if (bytes > s_omniExecMaxBytes || s_omniExecEnd) {
+        fprintf(stderr, "jit: executable reservation refused bytes=%zu existing=%d\n", bytes, s_omniExecEnd ? 1 : 0);
+        return nullptr;
