+namespace OmniRaster {
+
+struct Stats {
+    uint64_t recorded { 0 }, direct { 0 }, fallbacks { 0 }, bands { 0 }, devicePixels { 0 }, verifyMismatches { 0 };
+    double recordMs { 0 }, replayMs { 0 }, replayMaxMs { 0 };
+    unsigned lines { 0 }, fallbackLines { 0 };
+    bool configLogged { false };
+};
+
+static Stats& stats()
+{
+    static Stats stats; // Main thread only.
+    return stats;
+}
+
+// Returns false when nothing was painted (caller paints directly, as before the patch).
+static bool paintThreaded(WebPage& webPage, ShareableBitmap& bitmap, const IntRect& bounds, const auto& rects, float deviceScaleFactor)
+{
+    const auto& config = OmniRaster::config();
+    auto& stats = OmniRaster::stats();
+    if (!stats.configLogged) {
+        stats.configLogged = true;
+        fprintf(stderr, "OMNI RASTER: config threads=%u minPixels=%llu bandRows=%d verify=%d\n", config.threads, static_cast<unsigned long long>(config.minPixels), config.bandRows, config.verify ? 1 : 0);
+        fflush(stderr);
+    }
+
+    IntSize size = bitmap.size();
+    uint64_t pixels = 0;
+    for (const auto& rect : rects)
+        pixels += static_cast<uint64_t>(rect.width() * deviceScaleFactor) * static_cast<uint64_t>(rect.height() * deviceScaleFactor);
+    auto plan = OmniRaster::planBands(static_cast<int>(std::lround(bounds.y() * deviceScaleFactor)), size.height(), config.bandRows);
+    if (config.threads <= 1 || pixels < config.minPixels || plan.bandCount < 2 || size.width() <= 0) {
+        ++stats.direct;
+        return false;
+    }
+
+    // One surface per worker, all over the shared bitmap memory with the bitmap's own SkImageInfo
+    // and SkSurfaceProps (LCD geometry). Created and destroyed on the main thread.
+    Vector<sk_sp<SkSurface>, maxThreads> surfaces;
+    SkSurface* rawSurfaces[maxThreads] = { };
+    for (unsigned i = 0; i < config.threads; ++i) {
+        auto surface = bitmap.createSurface();
+        if (!surface) {
+            ++stats.direct;
+            return false;
+        }
+        rawSurfaces[i] = surface.get();
+        surfaces.append(WTF::move(surface));
+    }
+
+    auto recordStart = MonotonicTime::now();
+    SkPictureRecorder recorder;
+    SkRTreeFactory rtreeFactory; // Bands replay only the ops intersecting their clip.
+    auto* recordingCanvas = recorder.beginRecording(SkRect::MakeIWH(size.width(), size.height()), &rtreeFactory);
+    {
+        // Same context setup as ShareableBitmap::createGraphicsContext() + display().
+        GraphicsContextSkia recordingContext(*recordingCanvas, RenderingMode::Unaccelerated, RenderingPurpose::ShareableSnapshot);
+        recordingContext.applyDeviceScaleFactor(deviceScaleFactor);
+        recordingContext.translate(-bounds.x(), -bounds.y());
+        for (const auto& rect : rects)
+            webPage.drawRect(recordingContext, rect);
+    }
+    auto picture = recorder.finishRecordingAsPicture();
+    auto replayStart = MonotonicTime::now();
+    if (!picture) {
+        // Cannot normally happen; the page is painted again directly.
+        ++stats.direct;
+        return false;
+    }
+
+    unsigned bands = 0;
+    const char* hazard = OmniRaster::replay(*picture, rawSurfaces, static_cast<unsigned>(surfaces.size()), size.width(), plan, bands);
+    auto replayEnd = MonotonicTime::now();
+
+    double replayMs = (replayEnd - replayStart).seconds() * 1000;
+    ++stats.recorded;
+    stats.recordMs += (replayStart - recordStart).seconds() * 1000;
+    stats.replayMs += replayMs;
+    stats.replayMaxMs = std::max(stats.replayMaxMs, replayMs);
+    stats.bands += bands;
+    stats.devicePixels += pixels;
+    if (hazard) {
+        ++stats.fallbacks;
+        if (stats.fallbackLines < 8) {
+            ++stats.fallbackLines;
+            fprintf(stderr, "OMNI RASTER: fallback main-thread replay reason=%s size=%dx%d\n", hazard, size.width(), size.height());
+            fflush(stderr);
+        }
+    } else if (config.verify) {
+        uint64_t mismatches = OmniRaster::countMismatches(*picture, rawSurfaces[0]->imageInfo(), rawSurfaces[0]->props(), plan, bitmap.span().data(), bitmap.bytesPerRow());
+        stats.verifyMismatches += mismatches;
+        if (mismatches)
+            fprintf(stderr, "OMNI RASTER: VERIFY MISMATCH pixels=%llu size=%dx%d bands=%u\n", static_cast<unsigned long long>(mismatches), size.width(), size.height(), bands);
+    }
+
+    if (!(stats.recorded % 30) && stats.lines < 80) {
+        ++stats.lines;
+        fprintf(stderr, "OMNI RASTER: threads=%u recorded=%llu direct=%llu fallbacks=%llu recordMs=%.3f replayMs=%.3f replayMaxMs=%.3f mpx=%.2f bands=%llu verifyMismatch=%llu\n",
+            config.threads, static_cast<unsigned long long>(stats.recorded), static_cast<unsigned long long>(stats.direct),
+            static_cast<unsigned long long>(stats.fallbacks), stats.recordMs, stats.replayMs, stats.replayMaxMs,
+            stats.devicePixels / 1e6, static_cast<unsigned long long>(stats.bands), static_cast<unsigned long long>(stats.verifyMismatches));
+        fflush(stderr);
+    }
+    return true;
+}
