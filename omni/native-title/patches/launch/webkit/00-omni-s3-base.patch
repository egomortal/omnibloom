+static constexpr unsigned maxThreads = 8;
+static constexpr unsigned defaultThreads = 4;
+static constexpr uint64_t defaultMinPixels = 256 * 256;
+static constexpr int defaultBandRows = 64;
+static constexpr size_t helperStackBytes = 2 * 1024 * 1024; // Explicit: do not rely on the platform pthread default.
+
+struct Config {
+    unsigned threads { defaultThreads };
+    uint64_t minPixels { defaultMinPixels };
+    int bandRows { defaultBandRows };
+    bool verify { false };
+};
+
+static bool parseUnsigned(const char* value, unsigned long max, unsigned long& result)
+{
+    if (!value || !*value)
+        return false;
+    char* end = nullptr;
+    unsigned long parsed = std::strtoul(value, &end, 10);
+    if (*end || parsed > max)
+        return false;
+    result = parsed;
+    return true;
+}
+
+static Config parseConfig(const char* threads, const char* minPixels, const char* bandRows, const char* verify)
+{
+    Config config;
+    unsigned long value = 0;
+    if (threads) {
+        if (parseUnsigned(threads, maxThreads, value) && value >= 1)
+            config.threads = static_cast<unsigned>(value);
+        else
+            fprintf(stderr, "OMNI RASTER: ignoring OMNI_RASTER_THREADS=%s (want 1..%u)\n", threads, maxThreads);
+    }
+    if (minPixels) {
+        if (parseUnsigned(minPixels, 1ul << 28, value))
+            config.minPixels = value;
+        else
+            fprintf(stderr, "OMNI RASTER: ignoring OMNI_RASTER_MIN_PIXELS=%s\n", minPixels);
+    }
+    if (bandRows) {
+        if (parseUnsigned(bandRows, 4096, value) && value >= 16)
+            config.bandRows = static_cast<int>(value);
+        else
+            fprintf(stderr, "OMNI RASTER: ignoring OMNI_RASTER_BAND_ROWS=%s (want 16..4096)\n", bandRows);
+    }
+    config.verify = verify && !std::strcmp(verify, "1");
+    return config;
+}
+
+static const Config& config()
+{
+    static const Config config = parseConfig(getenv("OMNI_RASTER_THREADS"), getenv("OMNI_RASTER_MIN_PIXELS"), getenv("OMNI_RASTER_BAND_ROWS"), getenv("OMNI_RASTER_VERIFY"));
+    return config;
+}
+
+// Band edges sit on a fixed grid of view rows (originY = bitmap top in view device pixels), so a
+// given page position is always split at the same rows whatever the dirty bounds of a frame are.
+// Banding is equivalent to painting the dirty region as stacked horizontal rects (which the
+// direct path already does for multi-rect regions); Skia AA paths/hairlines/clip paths crossing
+// a band edge can differ from one unclipped paint by small coverage amounts on edge pixels.
+struct BandPlan {
+    int height { 0 };
+    int bandRows { 0 };
+    int phase { 0 }; // Rows of the first grid band that lie above the bitmap.
+    unsigned bandCount { 0 };
+
+    void band(unsigned index, int& top, int& bottom) const
+    {
+        top = std::max(0, static_cast<int>(index) * bandRows - phase);
+        bottom = std::min(height, static_cast<int>(index + 1) * bandRows - phase);
+    }
+};
+
+static BandPlan planBands(int originY, int height, int bandRows)
+{
+    BandPlan plan;
+    plan.height = height;
+    plan.bandRows = std::max(1, bandRows);
+    plan.phase = ((originY % plan.bandRows) + plan.bandRows) % plan.bandRows;
+    plan.bandCount = static_cast<unsigned>((height + plan.phase + plan.bandRows - 1) / plan.bandRows);
+    return plan;
+}
+
+// Fixed pool: worker 0 is the calling thread, workers 1..threads-1 are helper threads that live
+// for the process lifetime. run() hands out task indices through an atomic counter and returns
+// only after every helper has finished the current generation.
+class Pool {
+public:
+    using Task = void (*)(void* context, unsigned worker, unsigned task);
+
+    explicit Pool(unsigned threads)
+        : m_threads(threads)
+    {
+        for (unsigned worker = 1; worker < threads; ++worker)
+            m_helpers.append(Thread::create("OmniRaster"_s, [this, worker] { helperLoop(worker); }, ThreadType::Unknown, Thread::defaultQOS, Thread::defaultSchedulingPolicy, StackAllocationSpecification::RequestSize(helperStackBytes)));
+    }
+
+    unsigned threads() const { return m_threads; }
+
+    void run(unsigned taskCount, Task task, void* context)
+    {
+        {
+            Locker locker { m_lock };
+            m_task = task;
+            m_context = context;
+            m_taskCount = taskCount;
+            m_nextTask.store(0, std::memory_order_relaxed);
+            m_busyHelpers = m_threads - 1;
+            ++m_generation;
+        }
+        m_wakeCondition.notifyAll();
+        drain(0);
+        Locker locker { m_lock };
+        while (m_busyHelpers)
+            m_doneCondition.wait(m_lock);
+        m_task = nullptr;
+        m_context = nullptr;
+    }
+
+private:
+    void helperLoop(unsigned worker)
+    {
+        uint64_t seenGeneration = 0;
+        while (true) {
+            {
+                Locker locker { m_lock };
+                while (m_generation == seenGeneration)
+                    m_wakeCondition.wait(m_lock);
+                seenGeneration = m_generation;
+            }
+            drain(worker);
+            {
+                Locker locker { m_lock };
+                if (!--m_busyHelpers)
+                    m_doneCondition.notifyAll();
+            }
+        }
+    }
+
+    void drain(unsigned worker)
+    {
+        // m_task/m_context/m_taskCount are published under m_lock before the generation bump.
+        for (unsigned task = m_nextTask.fetch_add(1, std::memory_order_relaxed); task < m_taskCount; task = m_nextTask.fetch_add(1, std::memory_order_relaxed))
+            m_task(m_context, worker, task);
+    }
+
+    const unsigned m_threads;
+    Vector<Ref<Thread>> m_helpers;
+    Lock m_lock;
+    Condition m_wakeCondition;
+    Condition m_doneCondition;
+    uint64_t m_generation { 0 };
+    unsigned m_busyHelpers { 0 };
+    Task m_task { nullptr };
+    void* m_context { nullptr };
+    unsigned m_taskCount { 0 };
+    std::atomic<unsigned> m_nextTask { 0 };
+};
+
+static Pool& pool(unsigned threads)
+{
+    static Pool* pools[maxThreads + 1] = { };
+    threads = std::clamp(threads, 1u, maxThreads);
+    if (!pools[threads])
+        pools[threads] = new Pool(threads); // Intentionally leaked: helpers live until process exit.
+    return *pools[threads];
+}
