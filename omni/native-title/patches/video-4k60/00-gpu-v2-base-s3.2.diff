+    if (ok) {
+        if (!g.readback.coherent) { VkMappedMemoryRange mr { VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE }; mr.memory = g.readback.memory; mr.size = VK_WHOLE_SIZE; g.vk.vkInvalidateMappedMemoryRanges(g.device, 1, &mr); }
