+            const uint32_t want = pqReference(px[i * 4], px[i * 4 + 1], px[i * 4 + 2], g.hdrWhite);
+            if (got[i] == want) continue;
+            ++off;
+            for (int s = 0; s < 30; s += 10) worst = std::max(worst, std::abs(int((got[i] >> s) & 1023) - int((want >> s) & 1023)));
