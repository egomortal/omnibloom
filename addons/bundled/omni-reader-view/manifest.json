{
  "manifest_version": 1,
  "id": "omni-reader-view",
  "name": "Reader view",
  "version": "1.0.0",
  "licence": "MIT",
  "source": "https://github.com/egomortal/omnibloom",
  "description": "Shows articles as large, clean text for reading from the sofa. A Reader view button appears on article pages; Alt+Shift+R or the quick switch also opens it.",
  "matches": [
    "*://*/*"
  ],
  "excludes": [],
  "js": [
    "core.js",
    "runtime.js"
  ],
  "css": [
    "addon.css"
  ],
  "run_at": "document_end",
  "all_frames": false,
  "default_on": false,
  "private_safe": true,
  "quick_switch": true,
  "live_toggle": true,
  "css_level": "user",
  "hosts": [],
  "settings": [
    {
      "key": "size",
      "type": "choice",
      "label": "Text size",
      "default": "large",
      "choices": [
        "medium",
        "large",
        "huge"
      ],
      "labels": [
        "Medium",
        "Large",
        "Huge"
      ]
    },
    {
      "key": "theme",
      "type": "choice",
      "label": "Colours",
      "default": "auto",
      "choices": [
        "auto",
        "dark",
        "light",
        "sepia"
      ],
      "labels": [
        "Follow Omni dark pages",
        "Dark",
        "Light",
        "Sepia"
      ]
    },
    {
      "key": "button",
      "type": "bool",
      "label": "Show the Reader view button on article pages",
      "default": true
    }
  ]
}
